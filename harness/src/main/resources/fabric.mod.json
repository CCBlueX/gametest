{
  "schemaVersion": 1,
  "id": "gametest-harness",
  "version": "${version}",
  "name": "Game test harness",
  "description": "Client game tests on a shared Paper server with an anticheat of choice watching.",
  "authors": ["CCBlueX"],
  "contact": {
    "sources": "https://github.com/CCBlueX/gametest"
  },
  "license": "GPL-3.0-or-later",
  "environment": "client",
  "entrypoints": {
    "preLaunch": ["net.ccbluex.gametest.harness.report.ConsoleFilter"]
  },
  "accessWidener": "gametest-harness.accesswidener",
  "mixins": ["gametest-harness.mixins.json"],
  "depends": {
    "minecraft": "~${minecraft}",
    "fabric-client-gametest-api-v1": "*",
    "fabric-networking-api-v1": "*",
    "fabric-language-kotlin": "*"
  }
}
